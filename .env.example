# LinkedQueue agent harness environment
# Ollama Cloud (no local install — API key from https://ollama.com/settings/keys)
HARNESS_BASE_URL=https://ollama.com/v1
HARNESS_MODEL=gemma4:31b
HARNESS_API_KEY=your-ollama-cloud-key

# Ollama Local (if you run ollama on your machine)
# HARNESS_BASE_URL=http://localhost:11434/v1
# HARNESS_MODEL=qwen3-coder
# HARNESS_API_KEY=none

# --- Cloud providers (free / cheap tiers) -------------------------------
# OpenRouter — many free models: gemma-3-27b-it:free, qwen3-235b-a22b:free,
# deepseek-chat-v3-0324:free, llama-3.3-70b-instruct:free
# HARNESS_BASE_URL=https://openrouter.ai/api/v1
# HARNESS_MODEL=google/gemma-3-27b-it:free
# HARNESS_API_KEY=sk-or-

# Groq — fast, free tier: llama-3.3-70b-versatile, gemma2-9b-it
# HARNESS_BASE_URL=https://api.groq.com/openai/v1
# HARNESS_MODEL=llama-3.3-70b-versatile
# HARNESS_API_KEY=gsk_

# Together AI — free credits: Qwen/Qwen3-235B-A22B, deepseek-ai/DeepSeek-V3
# HARNESS_BASE_URL=https://api.together.xyz/v1
# HARNESS_MODEL=Qwen/Qwen3-235B-A22B
# HARNESS_API_KEY=...

# Fireworks AI — free credits
# HARNESS_BASE_URL=https://api.fireworks.ai/inference/v1
# HARNESS_MODEL=accounts/fireworks/models/qwen3-235b-a22b
# HARNESS_API_KEY=...

# Google AI Studio (Gemini, OpenAI-compatible) — free tier
# HARNESS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# HARNESS_MODEL=gemini-2.5-flash
# HARNESS_API_KEY=...

# Override data/skill/plugin/workspace locations (defaults live inside the repo)
# HARNESS_DATA=
# HARNESS_SKILLS=
# HARNESS_PLUGINS=
# HARNESS_WORKSPACE=

