{
  "name": "linkedqueue",
  "version": "0.4.0",
  "description": "Versatile AI agent harness with OpenClaw-style specialist agents — one TypeScript core behind an Electron UI and CLI.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "vercel --prod --cwd .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
